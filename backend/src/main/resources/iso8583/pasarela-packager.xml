<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE isopackager SYSTEM "genericpackager.dtd">

<isopackager>

    <!-- 000 - Message Type Indicator -->
    <isofield
        id="0"
        length="4"
        name="Message Type Indicator"
        class="org.jpos.iso.IFA_NUMERIC"/>

    <!-- 001 - Bitmap de 128 bits -->
    <!-- 16 bytes = 128 bits = 32 caracteres hexadecimales -->
    <isofield
        id="1"
        length="32"
        name="Bitmap 128 bits"
        class="org.jpos.iso.IFA_BITMAP"/>

    <!-- 002 - Primary Account Number -->
    <isofield
        id="2"
        length="19"
        name="Primary Account Number"
        class="org.jpos.iso.IFA_LLNUM"/>

    <!-- 003 - Processing Code -->
    <isofield
        id="3"
        length="6"
        name="Processing Code"
        class="org.jpos.iso.IFA_NUMERIC"/>

    <!-- 004 - Transaction Amount -->
    <isofield
        id="4"
        length="12"
        name="Amount Transaction"
        class="org.jpos.iso.IFA_NUMERIC"/>

    <!-- 007 - Transmission Date and Time -->
    <isofield
        id="7"
        length="10"
        name="Transmission Date Time"
        class="org.jpos.iso.IFA_NUMERIC"/>

    <!-- 011 - System Trace Audit Number -->
    <isofield
        id="11"
        length="6"
        name="System Trace Audit Number"
        class="org.jpos.iso.IFA_NUMERIC"/>

    <!-- 012 - Local Transaction Time -->
    <isofield
        id="12"
        length="6"
        name="Local Transaction Time"
        class="org.jpos.iso.IFA_NUMERIC"/>

    <!-- 013 - Local Transaction Date -->
    <isofield
        id="13"
        length="4"
        name="Local Transaction Date"
        class="org.jpos.iso.IFA_NUMERIC"/>

    <!-- 037 - Retrieval Reference Number -->
    <isofield
        id="37"
        length="12"
        name="Retrieval Reference Number"
        class="org.jpos.iso.IF_CHAR"/>

    <!-- 039 - Response Code -->
    <isofield
        id="39"
        length="2"
        name="Response Code"
        class="org.jpos.iso.IFA_NUMERIC"/>

    <!-- 041 - Terminal ID -->
    <isofield
        id="41"
        length="8"
        name="Terminal ID"
        class="org.jpos.iso.IF_CHAR"/>

    <!-- 042 - Merchant ID -->
    <isofield
        id="42"
        length="15"
        name="Merchant ID"
        class="org.jpos.iso.IF_CHAR"/>

    <!-- 049 - Currency Code -->
    <isofield
        id="49"
        length="3"
        name="Currency Code"
        class="org.jpos.iso.IFA_NUMERIC"/>

    <!-- 070 - Network Management Information Code -->
    <isofield
        id="70"
        length="3"
        name="Network Management Information Code"
        class="org.jpos.iso.IFA_NUMERIC"/>

    <!-- 102 - Account Identification 1 -->
    <isofield
        id="102"
        length="28"
        name="Account Identification 1"
        class="org.jpos.iso.IFA_LLCHAR"/>

    <!-- 128 - Message Authentication Code -->
    <isofield
        id="128"
        length="16"
        name="Message Authentication Code"
        class="org.jpos.iso.IF_CHAR"/>

</isopackager>